# Copy to .env.local for local development. Never commit .env.local.
# In Vercel, set these under Project → Settings → Environment Variables,
# separately for Development, Preview and Production.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key is safe in the browser because RLS enforces access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# OnPoint does not use the service-role key anywhere. If you add server-only
# jobs later, keep it server-side only and never prefix it with NEXT_PUBLIC_.
