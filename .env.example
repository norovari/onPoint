# Copy to .env.local for local development. Never commit .env.local.
# In Vercel: Project → Settings → Environment Variables (set for Production and Preview).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key: safe in the browser because RLS enforces access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret (service role) key: SERVER ONLY. Used just for PayFast payment notifications
# and the monthly billing job. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Your site ---
NEXT_PUBLIC_SITE_URL=https://your-onpoint-domain.co.za
NEXT_PUBLIC_LEGAL_NAME=Norovari (Pty) Ltd t/a OnPoint
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-onpoint-domain.co.za

# --- Card payments (PayFast, Norovari (Pty) Ltd's merchant account) ---
# From PayFast: Settings -> Developer Settings. Set the same passphrase there.
# Use letters and numbers only for the passphrase. Leave empty until PayFast
# approves the account; until then owners are asked to contact you.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# true = PayFast sandbox (test cards, no real money). Remove for live.
PAYFAST_SANDBOX=

# --- Monthly card renewals (Vercel Cron sends this as a bearer token) ---
CRON_SECRET=make-a-long-random-string

# --- Email alerts (Resend). Leave empty to show alerts in the app only. ---
RESEND_API_KEY=
ALERT_FROM_EMAIL=OnPoint <alerts@your-onpoint-domain.co.za>
